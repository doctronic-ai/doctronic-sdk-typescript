{
  "name": "@doctronic-ai/browser",
  "version": "0.0.0",
  "description": "Browser client for the Doctronic embed API, for partners using a publishable key",
  "keywords": [
    "doctronic",
    "healthcare",
    "telehealth",
    "telemedicine",
    "ai",
    "api",
    "sdk",
    "client",
    "browser",
    "embed",
    "typescript"
  ],
  "author": "Doctronic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doctronic-ai/doctronic-sdk-typescript.git",
    "directory": "packages/browser"
  },
  "bugs": {
    "url": "https://github.com/doctronic-ai/doctronic-sdk-typescript/issues"
  },
  "homepage": "https://docs.doctronic.ai",
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "check:package": "node scripts/check-package.mjs"
  }
}
